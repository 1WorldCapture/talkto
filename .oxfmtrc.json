{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "ignorePatterns": [
    "prototypes/**",
    "design/**",
    ".product/approved/**",
    "pnpm-lock.yaml",
    "apps/server/contracts/**",
    "**/node_modules/**",
    "**/.wrangler/**",
    "**/dist/**",
    "**/coverage/**",
    "**/worker-configuration.d.ts",
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "tools/oxlint/anti-slop/**",
    "apps/docs/.astro/**",
    "apps/docs/.nimbus/**",
    "apps/docs/src/components/ui/**",
    "apps/docs/src/lib/**"
  ]
}

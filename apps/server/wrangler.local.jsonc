{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "talkto-local",
  "main": "src/local.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_als"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "TALKTO_SERVER_NAME": "TalkTo Local",
    "TALKTO_SERVICE_ORIGIN": "http://127.0.0.1:8787",
    "TALKTO_PRINCIPAL_KEY": "local:owner",
  },
  "durable_objects": { "bindings": [{ "name": "SERVERS", "class_name": "TalkToServer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TalkToServer"] }],
  "rules": [{ "type": "Text", "globs": ["**/*.sql", "**/*.md"], "fallthrough": true }],
}

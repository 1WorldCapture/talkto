{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "talkto-test",
  "main": "test/fixture.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_als"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": { "bindings": [{ "name": "SERVERS", "class_name": "TestServer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TestServer"] }],
  "rules": [{ "type": "Text", "globs": ["**/*.sql", "**/*.md"], "fallthrough": true }],
}

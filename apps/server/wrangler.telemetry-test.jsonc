{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "talkto-telemetry-test",
  "main": "test/telemetry-fixture.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_als"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": { "bindings": [{ "name": "SERVERS", "class_name": "PlatformTestServer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PlatformTestServer"] }],
  "d1_databases": [
    {
      "binding": "PLATFORM",
      "database_name": "platform-test",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  "rules": [{ "type": "Text", "globs": ["**/*.sql", "**/*.md"], "fallthrough": true }],
}
